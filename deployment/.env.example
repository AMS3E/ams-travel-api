# Committed template for the local stack. `cp .env.example .env` gives a
# working development environment; replace every credential below before this
# runs anywhere that is not localhost.
#
# Two characters must never appear in a value here: `#` (Compose reads it as a
# comment) and `$` (Compose reads it as interpolation). `@` is fine everywhere
# except the passwords that get spliced into a database URI, where it is the
# host separator.

APP_PORT=8080
FRONTEND_PORT=3000
FRONTEND_PUBLIC_URL=http://localhost:3000
ADMIN_DASHBOARD_PORT=3001
ADMIN_PUBLIC_URL=http://localhost:3001

# 5433 on purpose: a native PostgreSQL service (postgresql-x64-17) owns 5432 on
# this machine, and on Windows Docker binds the port anyway rather than failing
# — so localhost:5432 reaches that server, not this one. Only the host side
# moves; inside the compose network the API still dials postgres:5432.
POSTGRES_PORT=5433
POSTGRES_DB=ams_travel
POSTGRES_USER=ams_user
POSTGRES_PASSWORD=change-me
# validate, not update: Liquibase owns the schema. With `update`, Hibernate
# alters tables behind the changelog and the two drift apart silently.
DDL_AUTO=validate

MINIO_API_PORT=9000
MINIO_CONSOLE_PORT=9001
MINIO_ROOT_USER=ams_minio
MINIO_ROOT_PASSWORD=change-me
MINIO_BUCKET=ams-travel-images
# Origin-relative: both Next.js apps proxy this exact path to the API, so one
# value works for a browser, for a server-side image optimizer inside the
# compose network, and for a crawler resolving the Open Graph tag.
IMAGE_PUBLIC_BASE_URL=/api/v1/medias
MAX_IMAGE_SIZE=10MB
MAX_UPLOAD_REQUEST_SIZE=50MB
API_REVALIDATE_SECONDS=300
GOOGLE_MAPS_EMBED_KEY=





# NOTE: the six SMTP_* values and the two STAFF_* below are NOT read by
# anything — not by compose, not by the API. Keycloak keeps its own copy of the
# SMTP settings in its database, entered in the console under Realm settings >
# Email, and the five desk accounts already exist there. These are kept as the
# record of what was entered and of the password those accounts were made with.
#
# Outgoing email for Keycloak: sign-up codes, sign-in codes, password resets.
# A Gmail App Password (Google Account > Security > App passwords, app name
# "AMS-Travel"), never the account's own password. Set on both realms in the
# Keycloak console, under Realm settings > Email.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=a-gmail-app-password
SMTP_FROM=
SMTP_FROM_NAME=AMS Travel
# NOT READ BY ANYTHING since 2026-09-27, when the realm provisioner was
# removed: the five back-office accounts already exist in amsadmin, and these
# two are kept only as the record of how they were made. Creating another one
# is a job for the Keycloak console.
#
# One real inbox for the seeded staff accounts' sign-in codes: with
# name@gmail.com here, the partner account gets its codes at
# name+partner@gmail.com, and so on. Gmail delivers every +tag to the same
# inbox. Empty keeps the placeholder addresses, which cannot receive a code.
STAFF_INBOX=
# The password every seeded staff account is created with. Each of them then
# also needs the code emailed to STAFF_INBOX, so this alone does not sign
# anyone in. Change it here and delete the accounts in the Keycloak console to
# have them made again; changing it does not touch accounts that already exist.
STAFF_PASSWORD=change-me

# Each realm's admin-cli secret: what this API authenticates to Keycloak with
# to create accounts and grant roles, and what the realm provisioner sets on
# the client when it builds a realm. They were written into
# KeycloakClientsConfig.java until 2026-09-25; they are credentials, so they
# live here with the rest.

# For amstravel
KEYCLOAK_CUSTOMER_CLIENT_SECRET=a-32-character-secret-from-keycloak
# For amsadmin
KEYCLOAK_BACKOFFICE_CLIENT_SECRET=a-32-character-secret-from-keycloak




# Keycloak development identity provider. Replace every secret outside local use.
# The server address stays in docker-compose.yml; its database and the bootstrap
# administrator are managed here.
KEYCLOAK_DB_NAME=db_keycloak
KEYCLOAK_DB_USER=postgres
KEYCLOAK_DB_PASSWORD=change-me
KEYCLOAK_BOOTSTRAP_ADMIN_USERNAME=admin
KEYCLOAK_BOOTSTRAP_ADMIN_PASSWORD=change-me
# The Spring Boot API reaches Keycloak's admin API as the service account of
# the confidential admin-cli client in each realm. Which realms, which client
# and which secret are in KeycloakAdminConfig, and the matching client is in
# the realm imports under keycloak/ — rotate a secret in both places at once.
# Records who changed what across the catalogue. Turn off only for load tests
# and bulk imports; with OAuth2 disabled entries have no named actor.
AUDIT_ENABLED=true
# How long an audit entry is kept. Entries older than this are dropped
# nightly at 03:30. 0 keeps everything.
AUDIT_RETENTION_DAYS=7

# Redis cache
REDIS_PORT=6379
REDIS_PASSWORD=change-me

# Maps. No Google key is needed: corridor roads are worked out on OpenStreetMap
# and drawn with Leaflet. Set the two NEXT_PUBLIC_ ones only if you switch the
# corridor maps back to Google — they are read by the browser, so they are
# public by design and must be restricted by referrer in the Google console.
GOOGLE_MAPS_API_KEY=
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=
NEXT_PUBLIC_GOOGLE_MAPS_MAP_ID=
# The OpenStreetMap routing server (OSRM). The public FOSSGIS one is for fair
# use, which a route asked for only when a corridor's stops change keeps to.
# Empty turns route calculation off; corridors then join their stops with
# straight lines.
OSM_ROUTING_URL=https://routing.openstreetmap.de

# Startup. Both are on unless set to false. Liquibase owns the schema, and the
# catalogue seeds itself only when no service reports any rows, so leaving both
# alone is safe — they are here because turning either off is an operational
# decision somebody may need to make.
LIQUIBASE_ENABLED=true
SEED_CATALOG=true

# How long a cached list lives before the API asks Postgres again.
CACHE_TTL=10m

# Event streaming and analytics

# Website client (amstravel-frontend) secret: the code exchange, refresh, sign-out. Server-side only.
# Keycloak console > amstravel > Clients > amstravel-frontend > Credentials.
KEYCLOAK_FRONTEND_CLIENT_SECRET=
# Dashboard client (amsadmin-dashboard) secret: the code exchange, refresh, sign-out. Server-side only.
# Keycloak console > amsadmin > Clients > amsadmin-dashboard > Credentials.
KEYCLOAK_DASHBOARD_CLIENT_SECRET=
