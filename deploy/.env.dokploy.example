# Paste into the Dokploy compose service's Environment tab, filled in. Every value is required
# unless marked optional. No "#" or "$" inside a value.

# --- Your domains (DNS must point them at the Dokploy server) ---
KEYCLOAK_PUBLIC_URL=https://auth.example.com
DASHBOARD_URL=https://cms.example.com
WEBSITE_URL=https://www.example.com
# The API's own public address: an earned badge's share link starts with it.
API_PUBLIC_URL=https://api.example.com
KEYCLOAK_SSL_REQUIRED=external

# --- Passwords and secrets: long random strings, made once, kept in your password manager ---
POSTGRES_PASSWORD=
APP_DB_PASSWORD=
KEYCLOAK_DB_PASSWORD=
KEYCLOAK_ADMIN_USER=admin
KEYCLOAK_ADMIN_PASSWORD=
MINIO_ROOT_USER=ams-minio
MINIO_ROOT_PASSWORD=
AMSTRAVEL_API_SECRET=
AMSADMIN_API_SECRET=
AMSADMIN_DASHBOARD_SECRET=
# The password of the seeded accounts (admin@ams.test, bdo@..., editor@..., contributor@..., partner@..., visitor@...).
# Strong, since these exist on the server; delete the ones you do not use once real staff accounts exist.
LOCAL_USER_PASSWORD=

# --- Mail: the account Keycloak sends verification codes and password resets from ---
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_STARTTLS=true
SMTP_SSL=false
SMTP_AUTH=true
SMTP_USER=the.account@gmail.com
SMTP_PASSWORD=the 16-character app password
SMTP_FROM=the.account@gmail.com
SMTP_FROM_NAME=AMS Travel

# --- Optional ---
# true seeds the catalogue on the first start; false when you load an export of your own content instead.
SEED_CATALOG=true
GOOGLE_MAPS_API_KEY=
# A staging reset: set a token never used before (e.g. 2026-10-15-lively) and the next start wipes the
# seeded catalogue and seeds it afresh; the token is remembered, so it never wipes twice.
SEED_RESET_TOKEN=
