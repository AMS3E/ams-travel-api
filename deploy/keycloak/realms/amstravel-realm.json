{
  "realm": "amstravel",
  "enabled": true,
  "displayName": "AMS Travel",
  "loginTheme": "amstravel",
  "sslRequired": "__SSL_REQUIRED__",
  "registrationAllowed": true,
  "loginWithEmailAllowed": true,
  "duplicateEmailsAllowed": false,
  "resetPasswordAllowed": true,
  "bruteForceProtected": false,
  "roles": {
    "realm": [
      {
        "name": "USER",
        "description": "Customer: a traveller signed in to the website"
      }
    ]
  },
  "defaultRoles": [
    "USER"
  ],
  "clients": [
    {
      "clientId": "amstravel-web",
      "name": "Public website (Next.js, port 3000)",
      "enabled": true,
      "publicClient": true,
      "protocol": "openid-connect",
      "standardFlowEnabled": true,
      "directAccessGrantsEnabled": false,
      "rootUrl": "http://localhost:3000",
      "redirectUris": [
        "__WEBSITE_URL__/*"
      ],
      "webOrigins": [
        "__WEBSITE_URL__"
      ],
      "attributes": {
        "pkce.code.challenge.method": "S256",
        "post.logout.redirect.uris": "http://localhost:3000/*"
      }
    },
    {
      "clientId": "amstravel-api",
      "enabled": true,
      "protocol": "openid-connect",
      "publicClient": false,
      "secret": "__AMSTRAVEL_API_SECRET__",
      "fullScopeAllowed": true,
      "standardFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "serviceAccountsEnabled": true,
      "name": "Spring API (customer accounts, client credentials)"
    },
    {
      "clientId": "local-cli",
      "name": "Local CLI (password grant, local only)",
      "enabled": true,
      "publicClient": true,
      "protocol": "openid-connect",
      "standardFlowEnabled": false,
      "directAccessGrantsEnabled": true,
      "serviceAccountsEnabled": false,
      "fullScopeAllowed": true
    },
    {
      "clientId": "amstravel-mobile",
      "name": "AMS Travel mobile app",
      "enabled": true,
      "publicClient": true,
      "protocol": "openid-connect",
      "standardFlowEnabled": true,
      "directAccessGrantsEnabled": false,
      "rootUrl": "",
      "redirectUris": [
        "amstravel://callback",
        "amstravel://*"
      ],
      "webOrigins": [],
      "attributes": {
        "pkce.code.challenge.method": "S256",
        "post.logout.redirect.uris": "amstravel://*"
      },
      "description": "The phone app: a public client with PKCE; it comes back to the app through its own URL scheme.",
      "baseUrl": "",
      "adminUrl": "",
      "implicitFlowEnabled": false,
      "serviceAccountsEnabled": false
    }
  ],
  "users": [
    {
      "username": "service-account-amstravel-api",
      "enabled": true,
      "serviceAccountClientId": "amstravel-api",
      "clientRoles": {
        "realm-management": [
          "manage-users",
          "view-users",
          "query-users"
        ]
      }
    },
    {
      "username": "visitor@ams.test",
      "email": "visitor@ams.test",
      "emailVerified": true,
      "enabled": true,
      "firstName": "Vanna",
      "lastName": "Visitor",
      "credentials": [
        {
          "type": "password",
          "value": "__LOCAL_USER_PASSWORD__",
          "temporary": false
        }
      ],
      "realmRoles": [
        "USER"
      ]
    }
  ],
