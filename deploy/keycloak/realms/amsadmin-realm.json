      {
        "name": "PERM_USER_MANAGE",
        "description": "Manage users: Manage all back-office accounts"
      },
      {
        "name": "PERM_VERIFIED_BADGE_SET",
        "description": "Verify destinations: Verify destinations submitted to the desk"
      },
      {
        "name": "ADMIN",
        "description": "Administrator: Manage users, roles, permissions, audit records, and the complete platform",
        "composite": true,
        "composites": {
          "realm": [
            "PARTNER",
            "CONTRIBUTOR",
            "EDITOR",
            "BDO",
            "PERM_FULL_CONTROL",
            "PERM_USER_MANAGE",
            "PERM_ROLE_ASSIGN",
            "PERM_AUDIT_VIEW"
          ]
        }
      },
      {
        "name": "BDO",
        "description": "Business development officer: Review partner destinations, manage the catalogue, and submit own content to an administrator",
        "composite": true,
        "composites": {
          "realm": [
            "PERM_CORRIDOR_CURATE",
            "PERM_DESTINATION_DRAFT_CREATE",
            "PERM_DESTINATION_DRAFT_DELETE_OWN",
            "PERM_DESTINATION_DRAFT_EDIT_OWN",
            "PERM_DESTINATION_EDIT_ANY",
            "PERM_DESTINATION_PUBLISH",
            "PERM_MEDIA_UPLOAD",
            "PERM_PARTNER_LISTING_DELETE",
            "PERM_PARTNER_LISTING_EDIT",
            "PERM_PARTNER_PUBLISH_APPROVE",
            "PERM_PUBLISH_REQUEST_SUBMIT",
            "PERM_PUBLISH_REQUEST_VIEW_OWN",
            "PERM_TAXONOMY_MANAGE",
            "PERM_VERIFIED_BADGE_SET"
