{
  "realm": "amsadmin",
  "enabled": true,
  "displayName": "AMS Travel back office",
  "loginTheme": "amstravel",
  "sslRequired": "__SSL_REQUIRED__",
  "registrationAllowed": false,
  "loginWithEmailAllowed": true,
  "duplicateEmailsAllowed": false,
  "resetPasswordAllowed": true,
  "bruteForceProtected": true,
  "permanentLockout": false,
  "failureFactor": 10,
  "waitIncrementSeconds": 60,
  "maxFailureWaitSeconds": 900,
  "maxDeltaTimeSeconds": 43200,
  "quickLoginCheckMilliSeconds": 1000,
  "minimumQuickLoginWaitSeconds": 60,
  "accessTokenLifespan": 900,
  "ssoSessionIdleTimeout": 1800,
  "ssoSessionMaxLifespan": 36000,
  "roles": {
    "realm": [
      {
        "name": "PERM_AUDIT_VIEW",
        "description": "View audit log: View the immutable audit log"
      },
      {
        "name": "PERM_CONTRIBUTOR_PUBLISH_APPROVE",
        "description": "Approve contributor requests: Approve or reject contributor publishing requests"
      },
      {
        "name": "PERM_CORRIDOR_CURATE",
        "description": "Curate corridors: Create and edit curated corridors"
      },
      {
        "name": "PERM_DESTINATION_DELETE",
        "description": "Delete destinations: Delete a destination"
      },
      {
        "name": "PERM_DESTINATION_DRAFT_CREATE",
        "description": "Create drafts: Create a destination draft"
      },
      {
        "name": "PERM_DESTINATION_DRAFT_DELETE_OWN",
        "description": "Delete own drafts: Delete an owned destination draft that is not live"
      },
      {
        "name": "PERM_DESTINATION_DRAFT_EDIT_OWN",
        "description": "Edit own drafts: Edit an owned destination draft"
      },
      {
        "name": "PERM_DESTINATION_EDIT_ANY",
        "description": "Edit any destination: Edit any destination"
      },
      {
        "name": "PERM_DESTINATION_PUBLISH",
        "description": "Publish destinations: Publish a destination"
      },
      {
        "name": "PERM_DESTINATION_UNPUBLISH",
        "description": "Unpublish destinations: Unpublish a destination"
      },
      {
        "name": "PERM_FULL_CONTROL",
        "description": "Full control: Full access to every amstravel capability"
      },
      {
        "name": "PERM_LISTING_DELETE_OWN",
        "description": "Delete own listings: Delete an owned listing that is not live"
      },
      {
        "name": "PERM_LISTING_EDIT_OWN",
        "description": "Edit own listings: Edit listings owned by the signed-in partner"
      },
      {
        "name": "PERM_MEDIA_UPLOAD",
        "description": "Upload media: Upload and manage owned media"
      },
      {
        "name": "PERM_PARTNER_LISTING_DELETE",
        "description": "Delete partner listings: Delete a submitted partner listing that is not live"
      },
      {
        "name": "PERM_PARTNER_LISTING_EDIT",
        "description": "Edit partner listings: Edit a submitted partner listing that is not live"
      },
      {
        "name": "PERM_PARTNER_PUBLISH_APPROVE",
        "description": "Approve partner requests: Approve or reject partner publishing requests"
      },
      {
        "name": "PERM_PUBLISH_REQUEST_SUBMIT",
        "description": "Submit for publishing: Submit a listing or draft for publishing"
      },
      {
        "name": "PERM_PUBLISH_REQUEST_VIEW_OWN",
        "description": "Track own requests: Track the status of owned publishing requests"
      },
      {
        "name": "PERM_REVIEW_MODERATE",
        "description": "Moderate reviews: Moderate destination reviews"
      },
      {
        "name": "PERM_ROLE_ASSIGN",
        "description": "Assign roles: Assign business roles to back-office users"
      },
      {
        "name": "PERM_TAXONOMY_MANAGE",
        "description": "Manage taxonomy: Create and edit regions, provinces, interests, categories and tags"
