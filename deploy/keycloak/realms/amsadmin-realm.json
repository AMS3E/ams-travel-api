        "composite": true,
        "composites": {
          "realm": [
            "PERM_DESTINATION_DRAFT_CREATE",
            "PERM_DESTINATION_DRAFT_DELETE_OWN",
            "PERM_DESTINATION_DRAFT_EDIT_OWN",
            "PERM_LISTING_DELETE_OWN",
            "PERM_LISTING_EDIT_OWN",
            "PERM_MEDIA_UPLOAD",
            "PERM_PUBLISH_REQUEST_SUBMIT",
            "PERM_PUBLISH_REQUEST_VIEW_OWN"
          ]
        }
      },
      {
        "name": "EDITOR",
        "description": "Editor: Review contributor destinations, manage the catalogue, and submit own content to an administrator",
        "composite": true,
        "composites": {
          "realm": [
            "PERM_CONTRIBUTOR_PUBLISH_APPROVE",
            "PERM_CORRIDOR_CURATE",
            "PERM_DESTINATION_DELETE",
            "PERM_DESTINATION_DRAFT_CREATE",
            "PERM_DESTINATION_EDIT_ANY",
            "PERM_DESTINATION_PUBLISH",
            "PERM_DESTINATION_UNPUBLISH",
            "PERM_MEDIA_UPLOAD",
            "PERM_PUBLISH_REQUEST_SUBMIT",
            "PERM_PUBLISH_REQUEST_VIEW_OWN",
            "PERM_REVIEW_MODERATE",
            "PERM_TAXONOMY_MANAGE"
          ]
        }
      },
      {
        "name": "PARTNER",
        "description": "Partner: Manage owned listings and submit them to BDO for publishing",
        "composite": true,
        "composites": {
          "realm": [
            "PERM_LISTING_DELETE_OWN",
