# Copy to .env in this folder and fill in the five passwords. Everything else can stay.
# Nothing here reaches the internet: Mailpit catches every mail, MinIO holds the pictures.

# --- Passwords and secrets (any value, 16+ characters; make them up once) ---
POSTGRES_PASSWORD=
APP_DB_PASSWORD=
KEYCLOAK_DB_PASSWORD=
KEYCLOAK_ADMIN_USER=admin
KEYCLOAK_ADMIN_PASSWORD=
MINIO_ROOT_USER=ams-local
MINIO_ROOT_PASSWORD=
# The API's and the dashboard's own Keycloak clients, and the test accounts' password (admin@ams.test, visitor@ams.test, ...).
AMSTRAVEL_API_SECRET=
AMSADMIN_API_SECRET=
AMSADMIN_DASHBOARD_SECRET=
LOCAL_USER_PASSWORD=

# --- Addresses ---
# The address Keycloak is reached at by a browser, a phone or an emulator. Tokens carry it, so it
# must be the address the app really uses:
#   this machine's browser ....... http://localhost:9090
#   Android emulator ............. http://10.0.2.2:9090
#   a real phone on the Wi-Fi .... http://<this machine's IP>:9090
#   hosted ....................... https://auth.yourdomain.com  (and KEYCLOAK_SSL_REQUIRED=external)
KEYCLOAK_PUBLIC_URL=http://localhost:9090
KEYCLOAK_SSL_REQUIRED=none
WEBSITE_URL=http://localhost:3000
DASHBOARD_URL=http://localhost:3001

# --- Ports on this machine ---
POSTGRES_PORT=5432
KEYCLOAK_PORT=9090
MINIO_PORT=9000
MINIO_CONSOLE_PORT=9001
MAILPIT_PORT=8025
API_PORT=8080
DASHBOARD_PORT=3001

# --- Optional ---
SEED_CATALOG=true
# The API's public origin, for the badge share links; the local port when left empty.
API_PUBLIC_URL=
GOOGLE_MAPS_API_KEY=
