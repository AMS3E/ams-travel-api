# Paste into the Dokploy *application* service for the dashboard (built from ams-travel-admin-dashboard,
# branch kimleng, with its Dockerfile). Same domains and the same dashboard secret as the compose env.
NEXT_PUBLIC_SITE_URL=https://cms.example.com
WEBSITE_URL=https://www.example.com
API_BASE_URL=https://api.example.com/api/v1
KEYCLOAK_ISSUER_URL=https://auth.example.com/realms/amsadmin
KEYCLOAK_INTERNAL_URL=https://auth.example.com/realms/amsadmin
KEYCLOAK_CLIENT_ID=amsadmin-dashboard
KEYCLOAK_CLIENT_SECRET=
PORT=3001
